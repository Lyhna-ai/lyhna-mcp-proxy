{
  "name": "@lyhna/mcp",
  "version": "0.1.1",
  "description": "Standalone Lyhna MCP proxy that intercepts MCP tools/call and routes through hosted bind().",
  "type": "module",
  "bin": {
    "lyhna-mcp": "./dist/src/bin/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "RUNNING.md",
    "AGENTS.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start:upstream": "tsx tests/fixtures/reference-upstream-mcp-server.ts",
    "start:proxy": "tsx src/bin/local-proxy.ts",
    "start:proxy:http": "tsx src/bin/http-proxy.ts",
    "inspect:proxy": "tsx src/bin/inspect-local-proxy.ts",
    "inspect:proxy:http": "tsx src/bin/inspect-http-proxy.ts",
    "adapter": "npm run build && node dist/src/bin/http-proxy.js",
    "demo": "node scripts/demo-golden-path.mjs",
    "demo:capsule": "node scripts/demo-capsule-gate.mjs",
    "capture:live": "node scripts/live-bind-capture.mjs",
    "test": "vitest run",
    "verify:legs": "node scripts/verify-legs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
