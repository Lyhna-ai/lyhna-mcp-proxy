{
  "name": "lyhna-mcp-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Lyhna MCP proxy that intercepts MCP tools/call and routes through hosted bind().",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start:upstream": "tsx tests/fixtures/reference-upstream-mcp-server.ts",
    "start:proxy": "tsx src/bin/local-proxy.ts",
    "start:proxy:http": "tsx src/bin/http-proxy.ts",
    "inspect:proxy": "tsx src/bin/inspect-local-proxy.ts",
    "inspect:proxy:http": "tsx src/bin/inspect-http-proxy.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
